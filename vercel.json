{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m venv .venv && .venv/bin/pip install --disable-pip-version-check -r requirements.txt",
  "buildCommand": ".venv/bin/mkdocs build --strict --site-dir dist/docs && cp dist/docs/404.html dist/404.html",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/docs/", "permanent": false }
  ]
}
